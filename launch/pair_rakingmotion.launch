from launch import LaunchDescription
from launch_ros.actions import Node
from ament_index_python.packages import get_package_share_directory
import os

def generate_launch_description():
    pkg_share = get_package_share_directory('rakingmotion_ur5e')
    param_file = os.path.join(pkg_share, 'config', 'rakingmotion_params.yaml')

    hr_node = Node(
        package='hr_executor',
        executable='concept_demo_hr',
        name='concept_demo_hr',
        output='screen',
        
    )


    forward_node = Node(
        package='rakingmotion_ur5e',
        executable='forward_rakingmotion',
        name='servo_forward_node',
        output='screen',
        parameters=[param_file],
    )

    back_node = Node(
        package='rakingmotion_ur5e',
        executable='return_rakingmotion',
        name='servo_back_node',
        output='screen',
        parameters=[param_file],
    )

    return LaunchDescription([
        forward_node,
        back_node,
        hr_node
    ])
